    <body>
      <div type="edition" n="Praep. Evang. (Frag. 1)" xml:lang="grc" xml:id="ver_Praep._Evang.__Frag._1_">
        <head>Praep. Evang. (Frag. 1)</head>
        <div type="book" n="9" xml:id="PhEPoet.ver_Praep._Evang.__Frag._1_.9">
          <head>Book 9</head>
          <div type="chapter" n="20" xml:id="PhEPoet.ver_Praep._Evang.__Frag._1_.9.20">
            <head>Chapter 20</head>
            <ab type="paragraph" n="1" xml:id="PhEPoet.ver_Praep._Evang.__Frag._1_.9.20.1">
              <app xml:id="u1_ver_Praep._Evang.__Frag._1_">
                <lem wit="#Mras">"Φησὶ δὲ περὶ τούτου καὶ Φίλων ἐν τῷ πρώτῳ τῶν Περὶ Ἱεροσόλυμα·</lem>
              </app>
              <app xml:id="u2_ver_Praep._Evang.__Frag._1_">
                <lem wit="#Mras">ΦΙΛΩΝΟΣ ΠΕΡΙ ΤΟΥ ΑΥΤΟΥ</lem>
              </app>
              <app xml:id="u3_ver_Praep._Evang.__Frag._1_">
                <lem wit="#Mras">'Ἔκλυον ἀρχεγόνοισι τὸ μηρίον ὥς ποτε θεσμοῖς, Ἁβραὰμ κλυτοηχὲς ὑπερτέρῳ ἅμματι δεσμῶν, παμφαές, πλήμμυρε μεγαυχήτοισι λογισμοῖς, θειοφιλῆ θέλγητρα. λιπόντι γὰρ ἀγλαὸν ἕρκος αἰνοφύτων ἔκκαυμα βριήπυος αἰνετὸς ἴσχων ἀθάνατον ποίησεν ἑὴν φάτιν, ἐξότε κείνου ἔκγονος αἰνογόνοιο πολύμνιον ἔλλαχε κῦδος,'</lem>
              </app>
              <app xml:id="u4_ver_Praep._Evang.__Frag._1_">
                <lem wit="#Mras">καὶ τὰ ἑξῆς·"</lem>
              </app>
            </ab>
          </div>
        </div>
      </div>
      <div type="edition" n="Praep. Evang. (Frag. 2)" xml:lang="grc" xml:id="ver_Praep._Evang.__Frag._2_">
        <head>Praep. Evang. (Frag. 2)</head>
        <div type="book" n="9" xml:id="PhEPoet.ver_Praep._Evang.__Frag._2_.9">
          <head>Book 9</head>
          <div type="chapter" n="20" xml:id="PhEPoet.ver_Praep._Evang.__Frag._2_.9.20">
            <head>Chapter 20</head>
            <ab type="paragraph" n="1" xml:id="PhEPoet.ver_Praep._Evang.__Frag._2_.9.20.1">
              <app xml:id="u5_ver_Praep._Evang.__Frag._2_">
                <lem wit="#Mras">"οἷς μετ᾽ ὀλίγα ἐπιφέρει·</lem>
              </app>
              <app xml:id="u6_ver_Praep._Evang.__Frag._2_">
                <lem wit="#Mras">'Ἀρτίχερος θηκτοῖο ξιφηφόρον ἐντύνοντος λήματι καὶ σφαράγοιο παρακλιδὸν ἀθροισθέντος· | ἀλλ᾽ ὁ μὲν ἐν χείρεσσι κερασφόρον ὤπασε κριόν,'</lem>
              </app>
              <app xml:id="u7_ver_Praep._Evang.__Frag._2_">
                <lem wit="#Mras">καὶ τὰ τούτοις ἑπόμενα."</lem>
              </app>
            </ab>
            <ab type="paragraph" n="2" xml:id="PhEPoet.ver_Praep._Evang.__Frag._2_.9.20.2">
              <app xml:id="u8_ver_Praep._Evang.__Frag._2_">
                <lem wit="#Mras">Ταῦτα μὲν δὴ ἀπὸ τῆς προειρημένης τοῦ Πολυΐστορος γραφῆς.</lem>
              </app>
            </ab>
          </div>
        </div>
      </div>
      <div type="edition" n="Praep. Evang. (Frag. 3)" xml:lang="grc" xml:id="ver_Praep._Evang.__Frag._3_">
        <head>Praep. Evang. (Frag. 3)</head>
        <div type="book" n="9" xml:id="PhEPoet.ver_Praep._Evang.__Frag._3_.9">
          <head>Book 9</head>
          <div type="chapter" n="24" xml:id="PhEPoet.ver_Praep._Evang.__Frag._3_.9.24">
            <head>Chapter 24</head>
            <ab type="paragraph" n="Heading" xml:id="PhEPoet.ver_Praep._Evang.__Frag._3_.9.24.Heading">
              <app xml:id="u9_ver_Praep._Evang.__Frag._3_">
                <lem wit="#Mras">ΦΙΛΩΝΟΣ ΠΕΡΙ ΤΟΥ ΙΩΣΗΦ· ΑΠΟ ΤΗΣ ΑΥΤΗΣ ΓΡΑΦΗΣ</lem>
              </app>
            </ab>
            <ab type="paragraph" n="1" xml:id="PhEPoet.ver_Praep._Evang.__Frag._3_.9.24.1">
              <app xml:id="u10_ver_Praep._Evang.__Frag._3_">
                <lem wit="#Mras">"Μαρτυρεῖ δὲ ταῖς ἱεραῖς βίβλοις καὶ Φίλων ἐν τῇ ιδ᾽ τῶν Περὶ Ἱεροσόλυμα, λέγων οὕτως·</lem>
              </app>
              <app xml:id="u11_ver_Praep._Evang.__Frag._3_">
                <lem wit="#Mras">'Τοῖσιν ἕδος μακαριστὸν ὅλης μέγας ἔκτισεν ἄκτωρ ὕψιστος καὶ πρόσθεν ἀφ᾽ Ἁβραάμοιο καὶ Ἰσὰκ Ἰακὼβ εὐτέκνοιό θ᾽ ὅθεν Ἰωσήφ, ὃς ὀνείρων θεσπιστὴς σκηπτοῦχος ἐν Αἰγύπτοιο θρόνοισι, δινεύσας λαθραῖα χρόνου πλημμυρίδι μοίρης',</lem>
              </app>
              <app xml:id="u12_ver_Praep._Evang.__Frag._3_">
                <lem wit="#Mras">καὶ τὰ ἑξῆς. ταῦτα καὶ περὶ τοῦ Ἰωσήφ."</lem>
              </app>
            </ab>
          </div>
        </div>
      </div>
      <div type="edition" n="Praep. Evang. (Frag. 4)" xml:lang="grc" xml:id="ver_Praep._Evang.__Frag._4_">
        <head>Praep. Evang. (Frag. 4)</head>
        <div type="book" n="9" xml:id="PhEPoet.ver_Praep._Evang.__Frag._4_.9">
          <head>Book 9</head>
          <div type="chapter" n="37" xml:id="PhEPoet.ver_Praep._Evang.__Frag._4_.9.37">
            <head>Chapter 37</head>
            <ab type="paragraph" n="Heading" xml:id="PhEPoet.ver_Praep._Evang.__Frag._4_.9.37.Heading">
              <app xml:id="u13_ver_Praep._Evang.__Frag._4_">
                <lem wit="#Mras">ΦΙΛΩΝΟΣ ΠΕΡΙ ΤΩΝ ΕΝ ΙΕΡΟΣΟΛΥΜΟΙΣ ΨΔΑΤΩΝ</lem>
              </app>
            </ab>
            <ab type="paragraph" n="1" xml:id="PhEPoet.ver_Praep._Evang.__Frag._4_.9.37.1">
              <app xml:id="u14_ver_Praep._Evang.__Frag._4_">
                <lem wit="#Mras">"Φησὶ δὲ ὁ Φίλων ἐν τοῖς Περὶ Ἱεροσολύμων κρήνην εἶναι, ταύτην δὲ ἐν | μὲν τῷ χειμῶνι ξηραίνεσθαι, ἐν δὲ τῷ θέρει πληροῦσθαι. λέγει δὲ ἐν τῇ πρώτῃ οὕτως·</lem>
              </app>
              <app xml:id="u15_ver_Praep._Evang.__Frag._4_">
                <lem wit="#Mras">'Νηχόμενος δ᾽ ἐφύπερθε τὸ θαμβηέστατον ἄλλο δέρκηθρον· συναοιδὰ μεγιστούχοιο λοετροῖς ῥεύματος ἐμπίπλησι βαθὺν ῥόον ἐξανιείσης,'</lem>
              </app>
              <app xml:id="u16_ver_Praep._Evang.__Frag._4_">
                <lem wit="#Mras">καὶ τὰ ἑξῆς."</lem>
              </app>
            </ab>
          </div>
        </div>
      </div>
      <div type="edition" n="Praep. Evang. (Frag. 5)" xml:lang="grc" xml:id="ver_Praep._Evang.__Frag._5_">
        <head>Praep. Evang. (Frag. 5)</head>
        <div type="book" n="9" xml:id="PhEPoet.ver_Praep._Evang.__Frag._5_.9">
          <head>Book 9</head>
          <div type="chapter" n="37" xml:id="PhEPoet.ver_Praep._Evang.__Frag._5_.9.37">
            <head>Chapter 37</head>
            <ab type="paragraph" n="2" xml:id="PhEPoet.ver_Praep._Evang.__Frag._5_.9.37.2">
              <app xml:id="u17_ver_Praep._Evang.__Frag._5_">
                <lem wit="#Mras">"οἷς πάλιν ὑποβὰς περὶ τῆς πληρώσεως ἐπιλέγει·</lem>
              </app>
              <app xml:id="u18_ver_Praep._Evang.__Frag._5_">
                <lem wit="#Mras">'Ῥεῦμα γὰρ ὑψιφάεννον, ἐν ὑετίοις νιφετοῖσιν ἱέμενον, πολυγηθές, ὑπαὶ πύργοις συνόροισιν στρωφᾶται, καὶ ξηρὰ πέδῳ κεκονιμένα κρήνης τηλεφαῆ δείκνυσιν ὑπέρτατα θάμβεα λαῶν,'</lem>
              </app>
              <app xml:id="u19_ver_Praep._Evang.__Frag._5_">
                <lem wit="#Mras">καὶ τὰ τούτοις ἀκόλουθα."</lem>
              </app>
            </ab>
          </div>
        </div>
      </div>
      <div type="edition" n="Praep. Evang. (Frag. 6)" xml:lang="grc" xml:id="ver_Praep._Evang.__Frag._6_">
        <head>Praep. Evang. (Frag. 6)</head>
        <div type="book" n="9" xml:id="PhEPoet.ver_Praep._Evang.__Frag._6_.9">
          <head>Book 9</head>
          <div type="chapter" n="37" xml:id="PhEPoet.ver_Praep._Evang.__Frag._6_.9.37">
            <head>Chapter 37</head>
            <ab type="paragraph" n="3" xml:id="PhEPoet.ver_Praep._Evang.__Frag._6_.9.37.3">
              <app xml:id="u20_ver_Praep._Evang.__Frag._6_">
                <lem wit="#Mras">"εἶτα πάλιν περὶ τῆς τοῦ ἀρχιερέως κρήνης καὶ τῆς ἀποχετεύσεως διέξεισιν οὕτως·</lem>
              </app>
              <app xml:id="u21_ver_Praep._Evang.__Frag._6_">
                <lem wit="#Mras">'Αἰπὺ δ᾽ ἄρ᾽ ἐκπτύουσι διὰ χθονὸς ὑδροχόοισι σωλῆνες,'</lem>
              </app>
              <app xml:id="u22_ver_Praep._Evang.__Frag._6_">
                <lem wit="#Mras">καὶ ὅσα ἄλλα τούτοις ἕπεται."</lem>
              </app>
              <app xml:id="u23_ver_Praep._Evang.__Frag._6_">
                <lem wit="#Mras">Τοσαῦτα μὲν δὴ τὰ ἀπὸ τῶν Ἀλεξάνδρου τοῦ Πολυΐστοπος.</lem>
              </app>
            </ab>
          </div>
        </div>
      </div>
      <div type="translation" n="Praep. Evang. (Frag. 1) (English)" xml:lang="en" xml:id="ver_Praep._Evang.__Frag._1___English_">
        <head>Praep. Evang. (Frag. 1) (English)</head>
        <div type="book" n="9" xml:id="PhEPoet.ver_Praep._Evang.__Frag._1___English_.9">
          <head>Book 9</head>
          <div type="chapter" n="20" xml:id="PhEPoet.ver_Praep._Evang.__Frag._1___English_.9.20">
            <head>Chapter 20</head>
            <ab type="paragraph" n="1" xml:id="PhEPoet.ver_Praep._Evang.__Frag._1___English_.9.20.1">
              <app xml:id="uen_1_ver_Praep._Evang.__Frag._1___English_">
                <lem wit="#OCP-Trans">Philo also says concerning this in the first book of his work *On Jerusalem*:</lem>
              </app>
              <app xml:id="uen_2_ver_Praep._Evang.__Frag._1___English_">
                <lem wit="#OCP-Trans">FROM PHILO, CONCERNING THE SAME.</lem>
              </app>
              <app xml:id="uen_3_ver_Praep._Evang.__Frag._1___English_">
                <lem wit="#OCP-Trans">“I heard how once, according to ancient customs, the thigh was unbound, Abraham, famous for his loud cry, with a superior bond of chains, all-shining, overflowing with boastful reasonings, and divine-loving charms. For having left the glorious enclosure, a terrible burning of wondrous plants, the much-speaking praiseworthy one, holding back, made his own fame immortal, since his descendant received much-sung glory from the wondrous offspring.”</lem>
              </app>
              <app xml:id="uen_4_ver_Praep._Evang.__Frag._1___English_">
                <lem wit="#OCP-Trans">and what follows.</lem>
              </app>
            </ab>
          </div>
        </div>
      </div>
      <div type="translation" n="Praep. Evang. (Frag. 2) (English)" xml:lang="en" xml:id="ver_Praep._Evang.__Frag._2___English_">
        <head>Praep. Evang. (Frag. 2) (English)</head>
        <div type="book" n="9" xml:id="PhEPoet.ver_Praep._Evang.__Frag._2___English_.9">
          <head>Book 9</head>
          <div type="chapter" n="20" xml:id="PhEPoet.ver_Praep._Evang.__Frag._2___English_.9.20">
            <head>Chapter 20</head>
            <ab type="paragraph" n="1" xml:id="PhEPoet.ver_Praep._Evang.__Frag._2___English_.9.20.1">
              <app xml:id="uen_5_ver_Praep._Evang.__Frag._2___English_">
                <lem wit="#OCP-Trans">"To which he adds a little later:</lem>
              </app>
              <app xml:id="uen_6_ver_Praep._Evang.__Frag._2___English_">
                <lem wit="#OCP-Trans">'While the sharpened blade of Articheres was making its assault with courage and a roar was gathered askance; | but he gave a horned ram into his hands,'</lem>
              </app>
              <app xml:id="uen_7_ver_Praep._Evang.__Frag._2___English_">
                <lem wit="#OCP-Trans">and the lines that follow."</lem>
              </app>
            </ab>
            <ab type="paragraph" n="2" xml:id="PhEPoet.ver_Praep._Evang.__Frag._2___English_.9.20.2">
              <app xml:id="uen_8_ver_Praep._Evang.__Frag._2___English_">
                <lem wit="#OCP-Trans">These indeed are from the aforementioned writing of Polyhistor.</lem>
              </app>
            </ab>
          </div>
        </div>
      </div>
      <div type="translation" n="Praep. Evang. (Frag. 3) (English)" xml:lang="en" xml:id="ver_Praep._Evang.__Frag._3___English_">
        <head>Praep. Evang. (Frag. 3) (English)</head>
        <div type="book" n="9" xml:id="PhEPoet.ver_Praep._Evang.__Frag._3___English_.9">
          <head>Book 9</head>
          <div type="chapter" n="24" xml:id="PhEPoet.ver_Praep._Evang.__Frag._3___English_.9.24">
            <head>Chapter 24</head>
            <ab type="paragraph" n="Heading" xml:id="PhEPoet.ver_Praep._Evang.__Frag._3___English_.9.24.Heading">
              <app xml:id="uen_9_ver_Praep._Evang.__Frag._3___English_">
                <lem wit="#OCP-Trans">PHILO CONCERNING JOSEPH; FROM THE SAME WRITING.</lem>
              </app>
            </ab>
            <ab type="paragraph" n="1" xml:id="PhEPoet.ver_Praep._Evang.__Frag._3___English_.9.24.1">
              <app xml:id="uen_10_ver_Praep._Evang.__Frag._3___English_">
                <lem wit="#OCP-Trans">Philo also testifies to the sacred books in the fourteenth book of his On Jerusalem, speaking thus:</lem>
              </app>
              <app xml:id="uen_11_ver_Praep._Evang.__Frag._3___English_">
                <lem wit="#OCP-Trans">'For them a blessed dwelling the great, highest creator built for all, and before from Abraham and Isaac and Jacob of the good children, from whom Joseph, interpreter of dreams, scepter-bearer on the thrones of Egypt, having secretly revolved by the flood of fate’s time,'</lem>
              </app>
              <app xml:id="uen_12_ver_Praep._Evang.__Frag._3___English_">
                <lem wit="#OCP-Trans">and what follows. These things also concern Joseph.</lem>
              </app>
            </ab>
          </div>
        </div>
      </div>
      <div type="translation" n="Praep. Evang. (Frag. 4) (English)" xml:lang="en" xml:id="ver_Praep._Evang.__Frag._4___English_">
        <head>Praep. Evang. (Frag. 4) (English)</head>
        <div type="book" n="9" xml:id="PhEPoet.ver_Praep._Evang.__Frag._4___English_.9">
          <head>Book 9</head>
          <div type="chapter" n="37" xml:id="PhEPoet.ver_Praep._Evang.__Frag._4___English_.9.37">
            <head>Chapter 37</head>
            <ab type="paragraph" n="Heading" xml:id="PhEPoet.ver_Praep._Evang.__Frag._4___English_.9.37.Heading">
              <app xml:id="uen_13_ver_Praep._Evang.__Frag._4___English_">
                <lem wit="#OCP-Trans">Philo on the Waters in Jerusalem</lem>
              </app>
            </ab>
            <ab type="paragraph" n="1" xml:id="PhEPoet.ver_Praep._Evang.__Frag._4___English_.9.37.1">
              <app xml:id="uen_14_ver_Praep._Evang.__Frag._4___English_">
                <lem wit="#OCP-Trans">"Philo says in his On Jerusalem that there is a spring, and this dries up in winter but fills up in summer. He says thus in the first book:</lem>
              </app>
              <app xml:id="uen_15_ver_Praep._Evang.__Frag._4___English_">
                <lem wit="#OCP-Trans">'And swimming above, one beholds another most amazing sight; in harmony with the baths of the great one, it fills the deep stream as it sends forth its flow,'</lem>
              </app>
              <app xml:id="uen_16_ver_Praep._Evang.__Frag._4___English_">
                <lem wit="#OCP-Trans">and what follows."</lem>
              </app>
            </ab>
          </div>
        </div>
      </div>
      <div type="translation" n="Praep. Evang. (Frag. 5) (English)" xml:lang="en" xml:id="ver_Praep._Evang.__Frag._5___English_">
        <head>Praep. Evang. (Frag. 5) (English)</head>
        <div type="book" n="9" xml:id="PhEPoet.ver_Praep._Evang.__Frag._5___English_.9">
          <head>Book 9</head>
          <div type="chapter" n="37" xml:id="PhEPoet.ver_Praep._Evang.__Frag._5___English_.9.37">
            <head>Chapter 37</head>
            <ab type="paragraph" n="2" xml:id="PhEPoet.ver_Praep._Evang.__Frag._5___English_.9.37.2">
              <app xml:id="uen_17_ver_Praep._Evang.__Frag._5___English_">
                <lem wit="#OCP-Trans">"Again, he adds concerning the fulfillment, stepping in after these things:</lem>
              </app>
              <app xml:id="uen_18_ver_Praep._Evang.__Frag._5___English_">
                <lem wit="#OCP-Trans">'For a high-shining stream, rushing forth in rainy snows, greatly rejoicing, wanders among the bordering towers, and shows the dry places on the ground, powdered with dust, the far-shining highest wonders of the peoples,'</lem>
              </app>
              <app xml:id="uen_19_ver_Praep._Evang.__Frag._5___English_">
                <lem wit="#OCP-Trans">and the things that follow these."</lem>
              </app>
            </ab>
          </div>
        </div>
      </div>
      <div type="translation" n="Praep. Evang. (Frag. 6) (English)" xml:lang="en" xml:id="ver_Praep._Evang.__Frag._6___English_">
        <head>Praep. Evang. (Frag. 6) (English)</head>
        <div type="book" n="9" xml:id="PhEPoet.ver_Praep._Evang.__Frag._6___English_.9">
          <head>Book 9</head>
          <div type="chapter" n="37" xml:id="PhEPoet.ver_Praep._Evang.__Frag._6___English_.9.37">
            <head>Chapter 37</head>
            <ab type="paragraph" n="3" xml:id="PhEPoet.ver_Praep._Evang.__Frag._6___English_.9.37.3">
              <app xml:id="uen_20_ver_Praep._Evang.__Frag._6___English_">
                <lem wit="#OCP-Trans">“Then again, he discusses the High Priest’s fountain and the drainage thus:</lem>
              </app>
              <app xml:id="uen_21_ver_Praep._Evang.__Frag._6___English_">
                <lem wit="#OCP-Trans">‘And steeply through the earth, water-bearing pipes spit out,’</lem>
              </app>
              <app xml:id="uen_22_ver_Praep._Evang.__Frag._6___English_">
                <lem wit="#OCP-Trans">and all the other things that follow these.”</lem>
              </app>
              <app xml:id="uen_23_ver_Praep._Evang.__Frag._6___English_">
                <lem wit="#OCP-Trans">So much, then, from Alexander Polyhistor.</lem>
              </app>
            </ab>
          </div>
        </div>
      </div>
      <div type="translation" n="Praep. Evang. (Frag. 1) (French)" xml:lang="fr" xml:id="ver_Praep._Evang.__Frag._1___French_">
        <head>Praep. Evang. (Frag. 1) (French)</head>
        <div type="book" n="9" xml:id="PhEPoet.ver_Praep._Evang.__Frag._1___French_.9">
          <head>Book 9</head>
          <div type="chapter" n="20" xml:id="PhEPoet.ver_Praep._Evang.__Frag._1___French_.9.20">
            <head>Chapter 20</head>
            <ab type="paragraph" n="1" xml:id="PhEPoet.ver_Praep._Evang.__Frag._1___French_.9.20.1">
              <app xml:id="ufr_1_ver_Praep._Evang.__Frag._1___French_">
                <lem wit="#OCP-Trans">« Philon parle également de cela dans le premier livre de son ouvrage Sur Jérusalem :</lem>
              </app>
              <app xml:id="ufr_2_ver_Praep._Evang.__Frag._1___French_">
                <lem wit="#OCP-Trans">DE PHILON SUR LE MÊME SUJET</lem>
              </app>
              <app xml:id="ufr_3_ver_Praep._Evang.__Frag._1___French_">
                <lem wit="#OCP-Trans">« J'ai appris autrefois, selon les décrets ancestraux, comment la cuisse d'Abraham au renom éclatant, toute resplendissante par le lien supérieur des entraves, déborda de pensées glorieuses, charmes chers à Dieu. Car, lorsqu'il quitta le splendide enclos, le Dieu à la voix puissante et loué, retenant le brasier des créatures redoutables, rendit immortelle sa propre parole, depuis que la descendance de cet illustre ancêtre a obtenu une gloire célébrée par de nombreux hymnes »,</lem>
              </app>
              <app xml:id="ufr_4_ver_Praep._Evang.__Frag._1___French_">
                <lem wit="#OCP-Trans">et la suite. »</lem>
              </app>
            </ab>
          </div>
        </div>
      </div>
      <div type="translation" n="Praep. Evang. (Frag. 2) (French)" xml:lang="fr" xml:id="ver_Praep._Evang.__Frag._2___French_">
        <head>Praep. Evang. (Frag. 2) (French)</head>
        <div type="book" n="9" xml:id="PhEPoet.ver_Praep._Evang.__Frag._2___French_.9">
          <head>Book 9</head>
          <div type="chapter" n="20" xml:id="PhEPoet.ver_Praep._Evang.__Frag._2___French_.9.20">
            <head>Chapter 20</head>
            <ab type="paragraph" n="1" xml:id="PhEPoet.ver_Praep._Evang.__Frag._2___French_.9.20.1">
              <app xml:id="ufr_5_ver_Praep._Evang.__Frag._2___French_">
                <lem wit="#OCP-Trans">« auquel il ajoute peu après :</lem>
              </app>
              <app xml:id="ufr_6_ver_Praep._Evang.__Frag._2___French_">
                <lem wit="#OCP-Trans">“Tandis que, d’une main assurée, il préparait avec résolution le glaive aiguisé, et que [la victime] était liée et ployée sur le côté ; mais Lui mit entre ses mains un bélier portant des cornes”,</lem>
              </app>
              <app xml:id="ufr_7_ver_Praep._Evang.__Frag._2___French_">
                <lem wit="#OCP-Trans">et ce qui suit. »</lem>
              </app>
            </ab>
            <ab type="paragraph" n="2" xml:id="PhEPoet.ver_Praep._Evang.__Frag._2___French_.9.20.2">
              <app xml:id="ufr_8_ver_Praep._Evang.__Frag._2___French_">
                <lem wit="#OCP-Trans">Voilà ce qui est tiré de l’écrit susmentionné de Polyhistor.</lem>
              </app>
            </ab>
          </div>
        </div>
      </div>
      <div type="translation" n="Praep. Evang. (Frag. 3) (French)" xml:lang="fr" xml:id="ver_Praep._Evang.__Frag._3___French_">
        <head>Praep. Evang. (Frag. 3) (French)</head>
        <div type="book" n="9" xml:id="PhEPoet.ver_Praep._Evang.__Frag._3___French_.9">
          <head>Book 9</head>
          <div type="chapter" n="24" xml:id="PhEPoet.ver_Praep._Evang.__Frag._3___French_.9.24">
            <head>Chapter 24</head>
            <ab type="paragraph" n="Heading" xml:id="PhEPoet.ver_Praep._Evang.__Frag._3___French_.9.24.Heading">
              <app xml:id="ufr_9_ver_Praep._Evang.__Frag._3___French_">
                <lem wit="#OCP-Trans">DE PHILON, SUR JOSEPH ; TIRÉ DU MÊME ÉCRIT</lem>
              </app>
            </ab>
            <ab type="paragraph" n="1" xml:id="PhEPoet.ver_Praep._Evang.__Frag._3___French_.9.24.1">
              <app xml:id="ufr_10_ver_Praep._Evang.__Frag._3___French_">
                <lem wit="#OCP-Trans">« Philon rend lui aussi témoignage aux livres sacrés dans le quatorzième livre de son ouvrage *Sur Jérusalem*, en s'exprimant ainsi :</lem>
              </app>
              <app xml:id="ufr_11_ver_Praep._Evang.__Frag._3___French_">
                <lem wit="#OCP-Trans">‹ Pour eux, le grand et très-haut guide fonda jadis une demeure bienheureuse, depuis Abraham et Isaac et Jacob aux beaux enfants, d'où est issu Joseph, interprète des songes, porteur de sceptre sur les trônes d'Égypte, qui scruta les mystères cachés dans le flot du destin du temps ›,</lem>
              </app>
              <app xml:id="ufr_12_ver_Praep._Evang.__Frag._3___French_">
                <lem wit="#OCP-Trans">et la suite. Voilà ce qui concerne aussi Joseph. »</lem>
              </app>
            </ab>
          </div>
        </div>
      </div>
      <div type="translation" n="Praep. Evang. (Frag. 4) (French)" xml:lang="fr" xml:id="ver_Praep._Evang.__Frag._4___French_">
        <head>Praep. Evang. (Frag. 4) (French)</head>
        <div type="book" n="9" xml:id="PhEPoet.ver_Praep._Evang.__Frag._4___French_.9">
          <head>Book 9</head>
          <div type="chapter" n="37" xml:id="PhEPoet.ver_Praep._Evang.__Frag._4___French_.9.37">
            <head>Chapter 37</head>
            <ab type="paragraph" n="Heading" xml:id="PhEPoet.ver_Praep._Evang.__Frag._4___French_.9.37.Heading">
              <app xml:id="ufr_13_ver_Praep._Evang.__Frag._4___French_">
                <lem wit="#OCP-Trans">DE PHILON : SUR LES EAUX DE JÉRUSALEM</lem>
              </app>
            </ab>
            <ab type="paragraph" n="1" xml:id="PhEPoet.ver_Praep._Evang.__Frag._4___French_.9.37.1">
              <app xml:id="ufr_14_ver_Praep._Evang.__Frag._4___French_">
                <lem wit="#OCP-Trans">« Philon dit, dans son traité Sur Jérusalem, qu'il existe une source, et que celle-ci s'assèche en hiver mais se remplit en été. Il s'exprime ainsi dans le premier livre :</lem>
              </app>
              <app xml:id="ufr_15_ver_Praep._Evang.__Frag._4___French_">
                <lem wit="#OCP-Trans">« Nageant par-dessus, un autre spectacle des plus admirables s'offre aux regards : en harmonie avec les ablutions du Très-Haut, le cours jaillissant emplit le profond lit du flot »,</lem>
              </app>
              <app xml:id="ufr_16_ver_Praep._Evang.__Frag._4___French_">
                <lem wit="#OCP-Trans">et la suite. »</lem>
              </app>
            </ab>
          </div>
        </div>
      </div>
      <div type="translation" n="Praep. Evang. (Frag. 5) (French)" xml:lang="fr" xml:id="ver_Praep._Evang.__Frag._5___French_">
        <head>Praep. Evang. (Frag. 5) (French)</head>
        <div type="book" n="9" xml:id="PhEPoet.ver_Praep._Evang.__Frag._5___French_.9">
          <head>Book 9</head>
          <div type="chapter" n="37" xml:id="PhEPoet.ver_Praep._Evang.__Frag._5___French_.9.37">
            <head>Chapter 37</head>
            <ab type="paragraph" n="2" xml:id="PhEPoet.ver_Praep._Evang.__Frag._5___French_.9.37.2">
              <app xml:id="ufr_17_ver_Praep._Evang.__Frag._5___French_">
                <lem wit="#OCP-Trans">À cela, il ajoute un peu plus bas, au sujet du remplissage :</lem>
              </app>
              <app xml:id="ufr_18_ver_Praep._Evang.__Frag._5___French_">
                <lem wit="#OCP-Trans">« Car un flot brillant dans les hauteurs, se précipitant dans des ondées pluvieuses, plein d'allégresse, tourbillonne sous les tours adjacentes, et montre au loin, jaillissant de la source, la terre desséchée et poudreuse, suprême merveille pour les peuples »,</lem>
              </app>
              <app xml:id="ufr_19_ver_Praep._Evang.__Frag._5___French_">
                <lem wit="#OCP-Trans">et la suite.</lem>
              </app>
            </ab>
          </div>
        </div>
      </div>
      <div type="translation" n="Praep. Evang. (Frag. 6) (French)" xml:lang="fr" xml:id="ver_Praep._Evang.__Frag._6___French_">
        <head>Praep. Evang. (Frag. 6) (French)</head>
        <div type="book" n="9" xml:id="PhEPoet.ver_Praep._Evang.__Frag._6___French_.9">
          <head>Book 9</head>
          <div type="chapter" n="37" xml:id="PhEPoet.ver_Praep._Evang.__Frag._6___French_.9.37">
            <head>Chapter 37</head>
            <ab type="paragraph" n="3" xml:id="PhEPoet.ver_Praep._Evang.__Frag._6___French_.9.37.3">
              <app xml:id="ufr_20_ver_Praep._Evang.__Frag._6___French_">
                <lem wit="#OCP-Trans">« Puis, il traite de nouveau de la source du grand prêtre et de la canalisation en ces termes :</lem>
              </app>
              <app xml:id="ufr_21_ver_Praep._Evang.__Frag._6___French_">
                <lem wit="#OCP-Trans">“Et d'en haut, à travers la terre, les tuyaux la crachent dans les conduits d'eau,”</lem>
              </app>
              <app xml:id="ufr_22_ver_Praep._Evang.__Frag._6___French_">
                <lem wit="#OCP-Trans">et tout ce qui s'ensuit. »</lem>
              </app>
              <app xml:id="ufr_23_ver_Praep._Evang.__Frag._6___French_">
                <lem wit="#OCP-Trans">Voilà pour ce qui provient des écrits d'Alexandre Polyhistor.</lem>
              </app>
            </ab>
          </div>
        </div>
      </div>
    </body>
  </text>
