    <body>
      <div type="edition" n="Shepherd of Hermas" xml:lang="grc" xml:id="ver_Shepherd_of_Hermas">
        <head>Shepherd of Hermas</head>
        <div type="book" n="Visions 2" xml:id="ElMod.ver_Shepherd_of_Hermas.Visions_2">
          <head>Book Visions 2</head>
          <div type="chapter" n="3" xml:id="ElMod.ver_Shepherd_of_Hermas.Visions_2.3">
            <head>Chapter 3</head>
            <ab type="verse" n="4" xml:id="ElMod.ver_Shepherd_of_Hermas.Visions_2.3.4">
              <app xml:id="u1_ver_Shepherd_of_Hermas">
                <lem wit="#Whittaker">“Ἐγγὺς κύριος τοῖς ἐπιστρεφομένοις,” ὡς γέγραπται ἐν τῷ Ἐλδὰδ καὶ Μωδάτ, τοῖς προφητεύσασιν ἐν τῇ ἐρήμῳ τῷ λαῷ.</lem>
              </app>
            </ab>
          </div>
        </div>
      </div>
      <div type="translation" n="English" xml:lang="en" xml:id="ver_English">
        <head>English</head>
        <div type="book" n="Visions 2" xml:id="ElMod.ver_English.Visions_2">
          <head>Book Visions 2</head>
          <div type="chapter" n="3" xml:id="ElMod.ver_English.Visions_2.3">
            <head>Chapter 3</head>
            <ab type="verse" n="4" xml:id="ElMod.ver_English.Visions_2.3.4">
              <app xml:id="uen_1_ver_English">
                <lem wit="#OCP-Trans">“The Lord is near to those who turn to him,” as it is written in Eldad and Modat, who prophesied to the people in the wilderness.</lem>
              </app>
            </ab>
          </div>
        </div>
      </div>
      <div type="translation" n="Shepherd of Hermas (French)" xml:lang="fr" xml:id="ver_Shepherd_of_Hermas__French_">
        <head>Shepherd of Hermas (French)</head>
        <div type="book" n="Visions 2" xml:id="ElMod.ver_Shepherd_of_Hermas__French_.Visions_2">
          <head>Book Visions 2</head>
          <div type="chapter" n="3" xml:id="ElMod.ver_Shepherd_of_Hermas__French_.Visions_2.3">
            <head>Chapter 3</head>
            <ab type="verse" n="4" xml:id="ElMod.ver_Shepherd_of_Hermas__French_.Visions_2.3.4">
              <app xml:id="ufr_1_ver_Shepherd_of_Hermas__French_">
                <lem wit="#OCP-Trans">« Le Seigneur est proche de ceux qui reviennent à lui », comme il est écrit dans Eldad et Modat, qui ont prophétisé au peuple dans le désert.</lem>
              </app>
            </ab>
          </div>
        </div>
      </div>
